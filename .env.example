# MealTracker environment configuration
# Copy this file to .env and fill in real values.

# PostgreSQL
POSTGRES_PASSWORD=change-me-in-prod
DATABASE_URL=postgresql+asyncpg://mealttracker:change-me-in-prod@localhost:5432/mealttracker

# iOS Shortcut ingest endpoint
# Create a random string and configure it in your iOS Shortcut X-Ingest-Secret header.
INGEST_SECRET=your-ios-shortcut-shared-secret

# Telegram bot
# Create a bot with BotFather.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Get your chat ID from a Telegram user info bot or from bot updates.
TELEGRAM_CHAT_ID=your-chat-id

# OpenRouter
# Get your key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key

# SearXNG
SEARXNG_SECRET=change-me-for-searxng

# Firecrawl
# Only needed if using a Firecrawl image requiring auth.
FIRECRAWL_PASSWORD=change-me-if-using-grounding
