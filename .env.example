# Postgres application database password.
POSTGRES_PASSWORD=change-me-in-prod

# Shared secret sent by the iOS Shortcut in the ingest request header.
INGEST_SECRET=your-ios-shortcut-shared-secret

# Host bind address and port for the local FastAPI service.
API_HOST_BIND=127.0.0.1
API_HOST_PORT=8000

# Telegram bot token from BotFather.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Telegram chat ID for the single allowed MealTracker chat.
TELEGRAM_CHAT_ID=your-chat-id

# OpenRouter API key for all LLM calls.
OPENROUTER_API_KEY=your-openrouter-key

# Firecrawl internal service password for grounding services.
FIRECRAWL_PASSWORD=change-me-if-using-grounding

# Secret used by self-hosted SearXNG for private-search mode.
SEARXNG_SECRET=changeme
