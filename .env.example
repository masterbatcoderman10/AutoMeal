# Postgres application database password.
POSTGRES_PASSWORD=change-me-in-prod

# Shared secret sent by the iOS Shortcut in the ingest request header.
INGEST_SECRET=your-ios-shortcut-shared-secret

# Host bind address and port for the local FastAPI service.
API_HOST_BIND=127.0.0.1
API_HOST_PORT=8000

# Telegram bot token from BotFather.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Telegram chat ID for the single allowed MealTracker chat.
TELEGRAM_CHAT_ID=your-chat-id

# OpenRouter API key for all LLM calls.
OPENROUTER_API_KEY=your-openrouter-key

# Langfuse is mandatory for all OpenAI-compatible LLM calls.
LANGFUSE_PUBLIC_KEY=pk-lf-your-project-key
LANGFUSE_SECRET_KEY=sk-lf-your-project-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=local
LANGFUSE_CAPTURE_IMAGES=false

# Optional Phase 2 vision overrides. Omit to use built-in defaults from app/config.py.
# DETECT_MODEL=google/gemma-4-31b-it
# SEGMENT_MODEL=google/gemini-3-flash-preview
# SEGMENT_RETRY_MODEL=google/gemini-3.5-flash
# LABEL_MODEL=google/gemini-3-flash-preview
# VISION_MAX_SEGMENTS=8

# Firecrawl internal service password for grounding services.
FIRECRAWL_PASSWORD=change-me-if-using-grounding

# Optional Firecrawl self-host search tuning. Compose passes these into the official
# Firecrawl /search backend so it uses SearXNG JSON output instead of defaulting to
# provider-managed web search.
FIRECRAWL_SEARCH_ENGINES=google,duckduckgo,bing,brave
FIRECRAWL_SEARCH_CATEGORIES=general
FIRECRAWL_MAX_RAM=0.8
FIRECRAWL_MAX_CPU=0.8

# If the official self-hosted Firecrawl /search verification is unstable on this machine,
# the runtime fallback is direct `searxng_search` + Firecrawl scrape rather than swapping
# to a different Firecrawl variant that only pretends to support /search.

# Secret used by self-hosted SearXNG for private-search mode.
SEARXNG_SECRET=changeme
