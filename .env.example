# MealTracker Environment Configuration
# Copy this file to .env and fill in all values

# PostgreSQL
POSTGRES_PASSWORD=change-me-in-prod

# iOS Shortcut Ingest Endpoint
# Create a random string and configure it in your iOS Shortcut header
INGEST_SECRET=your-ios-shortcut-shared-secret

# Telegram Bot
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Get your chat ID by messaging @userinfobot on Telegram
TELEGRAM_CHAT_ID=your-chat-id

# OpenRouter (LLM Gateway)
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key

# Firecrawl (Web Scraping)
# Only needed if using grounding tools; set any value for self-hosted
FIRECRAWL_PASSWORD=change-me-if-using-grounding
